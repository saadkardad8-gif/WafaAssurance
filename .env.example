# ============ Application ============
NODE_ENV=development
PORT=3000
# URL publique HTTPS de la plateforme (obligatoire en production)
APP_URL=http://localhost:3000
# Générez une valeur longue et aléatoire :  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changez-moi
OTP_SECRET=changez-moi-aussi

# Tentatives de connexion autorisées par 15 min et par IP (défaut : 100 en développement, 20 en production)
LOGIN_RATE_LIMIT=100

# ============ Base de données MySQL ============
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aak_pay
DB_PASSWORD=motdepasse
DB_NAME=aak_pay

# ============ SMS (code OTP) ============
# console  = affiche le code dans le terminal (développement uniquement, refusé en production)
# twilio   = https://www.twilio.com
# infobip  = https://www.infobip.com
SMS_PROVIDER=console
SMS_SENDER=AhlAlKhair

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro Twilio (+1...) OU Messaging Service SID (MG...)
TWILIO_FROM=

INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
INFOBIP_API_KEY=

# ============ Paiement par carte — CMI ============
# Fournis par le CMI après signature du contrat commerçant avec votre banque.
# Laissez vides en développement : un simulateur de page de paiement prend le relais.
CMI_CLIENT_ID=
CMI_STORE_KEY=
# Test : https://testpayment.cmi.co.ma/fim/est3Dgate
# Production : https://payment.cmi.co.ma/fim/est3Dgate
CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate
